<header class="site-header">
  <div class="header-inner wrap">
    <a class="brand" href="<%= url_for('/') %>" aria-label="<%= config.title %> 首页"><% if (theme.logo && theme.logo.enable && theme.logo.image) { %><img class="brand-image" src="<%= url_for(theme.logo.image) %>" alt="" width="34" height="34"><% } %><span><%= config.title %></span></a>
    <button class="mobile-menu-toggle icon-button" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="site-nav"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    <nav id="site-nav" class="site-nav" aria-label="主导航">
      <% const menu = config.theme_config && Object.prototype.hasOwnProperty.call(config.theme_config, 'menu') ? config.theme_config.menu : theme.menu; const currentPath = '/' + String(page.path || '').replace(/^\/+/, '').replace(/index\.html$/, '').replace(/\/+$/, '') + '/'; const menuMatches = function(href) { const path = '/' + String(href || '').replace(/^\/+/, '').replace(/index\.html$/, '').replace(/\/+$/, '') + '/'; return path === '//' ? currentPath === '//' : currentPath.startsWith(path); }; Object.entries(menu || {}).forEach(function(entry) { const label=entry[0], value=entry[1]; %>
        <% if (typeof value === 'string') { %>
          <a class="nav-link<%= menuMatches(value) ? ' is-active' : '' %>" href="<%= url_for(value) %>"<% if (menuMatches(value)) { %> aria-current="page"<% } %>><%= label %></a>
        <% } else { %>
          <% const children = Object.entries(value || {}); const activeGroup = children.some(function(child) { return menuMatches(child[1]); }) || (page.layout === 'post' && children.some(function(child) { return /^\/archives\/?$/.test(child[1]); })); %>
          <div class="nav-group<%= activeGroup ? ' is-current' : '' %>">
            <button class="nav-link nav-group-toggle<%= activeGroup ? ' is-active' : '' %>" type="button" aria-expanded="false"><%= label %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>
            <div class="nav-submenu">
              <% children.forEach(function(child) { %><a class="<%= menuMatches(child[1]) ? 'is-active' : '' %>" href="<%= url_for(child[1]) %>"<% if (menuMatches(child[1])) { %> aria-current="page"<% } %>><%= child[0] %></a><% }); %>
            </div>
          </div>
        <% } %>
      <% }); %>
    </nav>
    <% const particles = theme.appearance && theme.appearance.particles || {}; const palette = Array.isArray(particles.palette) ? particles.palette : []; %>
    <% if (palette.length) { %><div class="particle-palette" role="group" aria-label="背景颗粒颜色"><% palette.forEach(function(color) { %><button class="particle-swatch" type="button" data-particle-name="<%= color.name %>" data-particle-from="<%= color.from %>" data-particle-to="<%= color.to %>" style="--swatch-from:<%= color.from %>;--swatch-to:<%= color.to %>" aria-label="<%= color.label || color.name %>" title="<%= color.label || color.name %>" aria-pressed="false"></button><% }); %></div><% } %>
    <button id="theme-toggle" class="icon-button theme-toggle" type="button" aria-label="切换背景明暗" title="切换背景明暗"><svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5 8.5 8.5 0 1 0 20.5 14.3Z"/></svg></button>
  </div>
</header>
