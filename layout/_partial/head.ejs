<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>" data-mode="<%= theme.appearance.mode || 'auto' %>" data-particle-default="<%= theme.appearance.particles && theme.appearance.particles.default || 'green' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <% const keywords = [...(Array.isArray(config.keywords) ? config.keywords : String(config.keywords || '').split(',')), ...(page.tags && typeof page.tags.toArray === 'function' ? page.tags.toArray().map(tag => tag.name) : [])].map(value => String(value).trim()).filter(Boolean); const summary = String(page.description || page.excerpt || page.content || config.description || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 90); const description = [page.title, summary, keywords.join('、')].filter(Boolean).join(' · '); %>
  <meta name="description" content="<%= description %>">
  <meta name="keywords" content="<%= [...new Set([page.title, ...keywords].filter(Boolean))].join(', ') %>">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <link rel="icon" href="<%= url_for('/images/favicon.ico') %>">
  <link rel="alternate" type="application/atom+xml" title="RSS" href="<%= url_for('/atom.xml') %>">
  <link rel="stylesheet" href="<%= url_for('/css/giorgio.css') %>">
  <% if (theme.ads && theme.ads.google && theme.ads.google.enable && theme.ads.google.client) { %><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= encodeURIComponent(theme.ads.google.client) %>" crossorigin="anonymous"></script><% } %>
  <script>document.documentElement.classList.add('page-loading');window.addEventListener('load',()=>document.documentElement.classList.remove('page-loading'),{once:true});try{let m=localStorage.getItem('giorgio-mode');if(m==='light'||m==='dark')document.documentElement.dataset.mode=m;let p=localStorage.getItem('giorgio-particle')||document.documentElement.dataset.particleDefault;let c=<%- JSON.stringify(theme.appearance.particles && theme.appearance.particles.palette || []).replace(/</g,'\\u003c') %>.find(x=>x.name===p);if(c&&/^#[0-9a-f]{6}$/i.test(c.from)&&/^#[0-9a-f]{6}$/i.test(c.to)){document.documentElement.style.setProperty('--header-line-from',c.from);document.documentElement.style.setProperty('--header-line-to',c.to)}}catch(e){}</script>
</head>
<body<% if (theme.appearance.cursor_glow) { %> class="glow-enabled"<% } %>>
<div class="page-loader" role="status" aria-label="页面加载中"><span class="page-loader-orbit" aria-hidden="true"><i></i><i></i><i></i></span><span>正在加载页面…</span></div>
<canvas class="background-dots" aria-hidden="true"></canvas>
<div class="cursor-glow" aria-hidden="true"></div>
