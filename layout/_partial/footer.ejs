<% const wormhole = theme.footer && theme.footer.wormhole; const wormholeOptions = typeof wormhole === 'string' ? {enable: true, position: 'footer', url: wormhole} : (wormhole || {}); %>
<% if (wormholeOptions.position !== 'footer') { %><div class="wormhole-centered"><%- partial('_partial/wormhole') %></div><% } %>
<%- partial('_partial/ad-original') %>
<footer class="site-footer wrap">
  <div>© <% if (theme.footer.since && Number(theme.footer.since) < new Date().getFullYear()) { %><%= theme.footer.since %>–<% } %><%= new Date().getFullYear() %> <%= config.author || config.title %></div>
  <div class="footer-links"><% if (theme.footer.privacy) { %><a href="<%= url_for(theme.footer.privacy) %>">隐私政策</a><% } %><% if (wormholeOptions.position === 'footer') { %><%- partial('_partial/wormhole') %><% } %><a href="<%= url_for('/atom.xml') %>">RSS ↗</a></div>
</footer>
<button id="back-to-top" class="back-to-top" type="button" aria-label="返回顶部" title="返回顶部"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 14 6-6 6 6"/></svg></button>
<dialog id="lightbox" class="lightbox" aria-label="查看图片"><button type="button" class="lightbox-close" aria-label="关闭"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></button><button type="button" class="lightbox-prev" aria-label="上一张"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button><span class="lightbox-status" role="status" aria-live="polite">图片加载中…</span><img alt=""><button type="button" class="lightbox-next" aria-label="下一张"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button></dialog>
<script src="<%= url_for('/js/giorgio.js') %>" defer></script>
</body>
</html>
