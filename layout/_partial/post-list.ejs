<% if (posts && posts.length) { %>
  <div class="post-list">
    <% posts.forEach(function(post) { %>
      <article class="post-row">
        <time class="post-row-date" datetime="<%= post.date.toISOString() %>"><span><%= date(post.date, 'MM.DD') %></span><small><%= date(post.date, 'YYYY') %></small></time>
        <a class="post-row-main" href="<%= url_for(post.path) %>"><span class="row-title"><%= post.title || '无题' %></span><% if (post.categories && post.categories.length) { %><span class="row-hint"><%= post.categories.toArray().map(function(category) { return category.name; }).join(' / ') %></span><% } %></a>
        <a class="row-arrow" href="<%= url_for(post.path) %>" aria-label="阅读 <%= post.title || '无题' %>">↗</a>
      </article>
    <% }); %>
  </div>
<% } else { %><p class="empty-state">这里暂时还没有文章。</p><% } %>
