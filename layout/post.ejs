<%- partial('_partial/head') %><%- partial('_partial/header') %><main class="wrap article-main"><article><header class="article-header"><a class="back-link" href="<%= url_for('/archives/') %>">← 返回上一页</a><div class="article-meta"><time datetime="<%= page.date.toISOString() %>"><%= date(page.date, 'YYYY 年 MM 月 DD 日') %></time><% if (page.categories && page.categories.length) { %><span>·</span><span><% page.categories.toArray().forEach(function(category, index) { %><% if (index) { %> / <% } %><a href="<%= url_for(category.path) %>"><%= category.name %></a><% }); %></span><% } %></div><h1><%= page.title %></h1><% if (page.description) { %><p><%= page.description %></p><% } %></header><div class="prose"><%- page.content %></div><% if (page.tags && page.tags.length) { %><div class="article-tags"><% page.tags.toArray().forEach(function(tag) { %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }); %></div><% } %></article><%- partial('_partial/ad-google', {position: 'post'}) %><%- partial('_partial/comments') %></main><%- partial('_partial/footer') %>
