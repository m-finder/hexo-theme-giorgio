<%- partial('_partial/head') %><%- partial('_partial/header') %>
<main class="wrap home-main">
  <section class="home-profile home-profile--<%= ['left', 'center', 'right'].includes(theme.profile.align) ? theme.profile.align : 'center' %>" aria-label="站点介绍">
    <img class="home-avatar" src="<%= url_for(theme.profile.avatar) %>" alt="" width="84" height="84">
    <h1><%= config.title %></h1>
    <% if (config.subtitle) { %><p class="home-subtitle"><%= config.subtitle %></p><% } %>
    <% if (config.description) { %><p class="home-description"><%= config.description %></p><% } %>
    <% if (theme.social && Object.keys(theme.social).length) { %>
      <div class="home-social" aria-label="社交媒体">
        <% Object.entries(theme.social).forEach(function(entry) { const label = entry[0], href = entry[1]; if (!href) return; %>
          <a href="<%= href %>" aria-label="<%= label %>" title="<%= label %>"<% if (/^https?:/i.test(href)) { %> target="_blank" rel="noopener noreferrer"<% } %>>
            <% if (/github/i.test(label)) { %><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.726-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.304-5.467-1.333-5.467-5.93 0-1.311.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.655 1.652.243 2.873.12 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .319.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            <% } else if (/mail|邮箱|email/i.test(label)) { %><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <% } else if (/rss|订阅/i.test(label)) { %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4c8.8 0 16 7.2 16 16M4 11c5 0 9 4 9 9"/><circle cx="5" cy="19" r="1" fill="currentColor" stroke="none"/></svg>
            <% } else { %><span><%= label %> ↗</span><% } %>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>
  <% if (theme.search && theme.search.enable) { %>
    <section class="home-search" role="search" aria-label="站内搜索">
      <form class="search-form" id="site-search-form" autocomplete="off">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
        <input id="site-search-input" data-search-index="<%= url_for('/giorgio-search.json') %>" type="search" placeholder="<%= theme.search.placeholder || '搜索文章…' %>" aria-label="搜索文章" aria-controls="site-search-results" aria-expanded="false">
        <kbd>⌘ K</kbd>
      </form>
      <div id="site-search-results" class="search-results" role="status" aria-live="polite" hidden></div>
    </section>
  <% } %>
  <% const home = theme.home || {}; const homeCategories = Array.isArray(home.categories) ? home.categories : []; const allPosts = site.posts.toArray().sort(function(a,b) { return b.date - a.date; }); %>
  <% if (homeCategories.length) { %>
    <div class="home-columns<%= homeCategories.length === 1 ? ' single-column' : '' %>">
      <% homeCategories.forEach(function(item) { const name = typeof item === 'string' ? item : item.name || item.category; const limit = typeof item === 'object' && item.limit != null ? Number(item.limit) : Number(home.limit || 12); const posts = allPosts.filter(function(post) { return post.categories && post.categories.toArray().some(function(category) { return category.name === name || category.slug === name; }); }).slice(0, Math.max(0, limit)); %>
        <section class="home-category">
          <div class="home-category-heading"><h2><%= name %></h2><a href="<%= url_for('/categories/' + encodeURIComponent(name) + '/') %>" aria-label="查看<%= name %>的全部文章">全部 ↗</a></div>
          <% if (posts.length) { %><div class="home-category-list"><% posts.forEach(function(post) { %><a class="home-category-row" href="<%= url_for(post.path) %>"><span class="home-category-title"><%= post.title %></span><time datetime="<%= post.date.toISOString() %>"><%= date(post.date, 'MM.DD') %></time></a><% }); %></div><% } else { %><p class="empty-state">这里暂时还没有文章。</p><% } %>
        </section>
      <% }); %>
    </div>
  <% } else { %>
    <section class="section-block home-posts"><div class="section-head"><div><h2>最近更新</h2></div><a href="<%= url_for('/archives/') %>">全部文章 ↗</a></div><%- partial('_partial/post-list', {posts: page.posts.toArray()}) %><%- partial('_partial/pagination') %></section>
  <% } %>
<%- partial('_partial/ad-google', {position: 'home'}) %>
</main><%- partial('_partial/footer') %>
